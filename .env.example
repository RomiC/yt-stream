# Public base URL of the service — used by Caddy as its site address
# and by the app to build the public stream URL.
# - Production (auto-HTTPS via Let's Encrypt): https://yts.charugin.me
# - Local development (plain HTTP on port 80): http://localhost
PUBLIC_BASE_URL=http://localhost

# Ports to be exposed by Docker - insecure and secure one
HTTP_PORT=80
HTTPS_PORT=443

# Health check service lives on a dedicated port, to be exposed along w/ HTTP_PORT and HTTPS_PORT.
HEALTH_PORT=8080

ICECAST_SOURCE_PASSWORD=secret
ICECAST_ADMIN_PASSWORD=admin

# API key required by all /api/* endpoints — sent as
# `Authorization: Bearer <key>`; `?key=` query auth needs ALLOW_KEY_IN_QUERY=true.
# A missing key falls back to a development default with a startup warning.
API_KEY=dev-api-key
# Enables `?key=<key>` auth. Unlike the header, a query key can leak into
# Caddy's error log (proxy failures log the full URI) and browser history.
ALLOW_KEY_IN_QUERY=false

LOG_LEVEL=info
STREAM_TTL_MINUTES=15
# Per-mount listener cap — applied only inside the Icecast container config;
# the app is unaware of it.
ICECAST_MAX_LISTENERS=2
PROXY_FILE=
STREAMLINK_QUALITY=audio_only,worst
