# node@24.20.0-alpine@3.24
FROM node:24-alpine@sha256:e67514e5d0f6c46656005e1b693b2ec9d52e80b641307de684d4a015ba7a4eaf

# Which workspace to build (stream | health) — set by compose build args
ARG SERVICE
# Optional pinned system packages (stream only), empty for health
ARG APK_PACKAGES=""

WORKDIR /app
RUN if [ -n "${APK_PACKAGES}" ]; then apk add --no-cache ${APK_PACKAGES} && rm -rf /var/cache/apk/*; fi

COPY package.json package-lock.json ./
COPY packages/stream/package.json packages/stream/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci --workspace=packages/${SERVICE} --omit=dev && npm cache clean --force

COPY packages/shared/ packages/shared/
COPY packages/${SERVICE}/src/ packages/${SERVICE}/src/

WORKDIR /app/packages/${SERVICE}
USER node

EXPOSE 8080
CMD ["node", "src/index.js"]
