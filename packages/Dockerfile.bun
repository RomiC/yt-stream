# Stage Bun into Alpine 3.24 to keep FFmpeg/Streamlink on the selected distro release
FROM oven/bun:1.4.4-alpine@sha256:4cf82f5686b196504fe119db3fcd9185b191f82ece82c40680e597228ec6070a AS bun

FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6

# Which workspace to build (stream | health) — set by compose build args
ARG SERVICE
# Optional version-constrained system packages (stream only), empty for health
ARG APK_PACKAGES=""
ARG APP_VERSION="dev"
ARG APP_COMMIT="unknown"

# Bun runtime: libgcc/libstdc++ for the binary, non-root `bun` user (mirrors oven/bun)
RUN apk add --no-cache libgcc libstdc++ \
    && addgroup -g 1000 bun \
    && adduser -u 1000 -G bun -s /bin/sh -D bun
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
RUN ln -s /usr/local/bin/bun /usr/local/bin/bunx

# No on-disk transpiler cache — the container filesystem is read-only at runtime
ENV BUN_RUNTIME_TRANSPILER_CACHE_PATH=0
ENV APP_VERSION=${APP_VERSION}
ENV APP_COMMIT=${APP_COMMIT}

WORKDIR /app
RUN if [ -n "${APK_PACKAGES}" ]; then apk add --no-cache ${APK_PACKAGES} && rm -rf /var/cache/apk/*; fi

COPY package.json bun.lock ./
COPY packages/stream/package.json packages/stream/package.json
COPY packages/health/package.json packages/health/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN bun install --frozen-lockfile --production

COPY packages/shared/ packages/shared/
COPY packages/${SERVICE}/src/ packages/${SERVICE}/src/

WORKDIR /app/packages/${SERVICE}
USER bun

EXPOSE 8080
CMD ["bun", "src/index.ts"]
