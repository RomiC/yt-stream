{
  "name": "yt-stream",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "test": "bun run --workspaces test",
    "test:health": "bun run --filter yt-stream-health test",
    "test:shared": "bun run --filter yt-stream-shared test",
    "test:stream": "bun run --filter yt-stream-stream test",
    "lint": "bun run --workspaces lint",
    "lint:health": "bun run --filter yt-stream-health lint",
    "lint:shared": "bun run --filter yt-stream-shared lint",
    "lint:stream": "bun run --filter yt-stream-stream lint",
    "lint:fix": "bun run --workspaces lint:fix",
    "lint:fix:health": "bun run --filter yt-stream-health lint:fix",
    "lint:fix:shared": "bun run --filter yt-stream-shared lint:fix",
    "lint:fix:stream": "bun run --filter yt-stream-stream lint:fix",
    "format": "oxfmt",
    "format:health": "bun run --filter yt-stream-health format",
    "format:shared": "bun run --filter yt-stream-shared format",
    "format:stream": "bun run --filter yt-stream-stream format",
    "format:check": "oxfmt --check",
    "format:check:health": "bun run --filter yt-stream-health format:check",
    "format:check:shared": "bun run --filter yt-stream-shared format:check",
    "format:check:stream": "bun run --filter yt-stream-stream format:check"
  },
  "homepage": "https://github.com/RomiC/yt-stream#readme",
  "bugs": {
    "url": "https://github.com/RomiC/yt-stream/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RomiC/yt-stream.git"
  },
  "license": "MIT",
  "author": "Roman Charugin <romic+github@fastmail.com>",
  "workspaces": [
    "packages/stream",
    "packages/health",
    "packages/shared"
  ],
  "dependencies": {
    "fastify": "5.12.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "24.13.5",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "^7.0.2"
  }
}
