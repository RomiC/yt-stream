    "lint:fix:stream": "npm run lint:fix --workspace=packages/stream",
    "format": "npm run format --workspaces",
    "format:health": "npm run format --workspace=packages/health",
    "format:shared": "npm run format --workspace=packages/shared",
    "format:stream": "npm run format --workspace=packages/stream",
    "format:check": "npm run format:check --workspaces",
    "format:check:health": "npm run format:check --workspace=packages/health",
    "format:check:shared": "npm run format:check --workspace=packages/shared",
    "format:check:stream": "npm run format:check --workspace=packages/stream"
  },
